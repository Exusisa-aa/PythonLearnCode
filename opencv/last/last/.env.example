# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 排除，不会被提交。

# 百度智能云应用凭据（必填）
# 获取方式：百度智能云控制台 → 人脸识别 → 创建应用 → 查看 API Key / Secret Key
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# 人脸库用户组名（选填）
# 仅允许数字、字母、下划线，长度不超过 48 字节。留空则使用 face_recognition。
FACE_GROUP_ID=face_recognition

# 相似度判定阈值（选填，0~100）
# 低于该分值判定为陌生人。百度官方推荐 80。留空则使用 80。
MATCH_THRESHOLD=80

# 注册时的图片质量控制（选填，NONE/LOW/NORMAL/HIGH），留空则使用 NORMAL。
# 等级越高越严格，不合格的照片会被接口直接拒绝并返回具体原因。
QUALITY_CONTROL=NORMAL

# 注册时的活体检测控制（选填，NONE/LOW/NORMAL/HIGH），留空则使用 NORMAL。
# NORMAL 会拒绝"二次翻拍"的照片（错误码 223120）。
# 若你主要用已有的图片文件（而不是现场拍摄）注册，被误拒时可改为 LOW 或 NONE。
LIVENESS_CONTROL=NORMAL
